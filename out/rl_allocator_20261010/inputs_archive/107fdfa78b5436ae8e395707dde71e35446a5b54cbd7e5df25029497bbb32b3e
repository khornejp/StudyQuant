def evaluate(history: dict[tuple[str, str], pd.DataFrame],
             full: dict[tuple[str, str], pd.DataFrame], definitions: pd.DataFrame,
             hist_market: pd.DataFrame, all_market: pd.DataFrame,
             hist_funding: pd.DataFrame, all_funding: pd.DataFrame
             ) -> tuple[pd.DataFrame, pd.DataFrame, dict[tuple, np.ndarray]]:
    metric_rows: list[dict[str, object]] = []
    daily_rows: list[dict[str, object]] = []
    daily_cache: dict[tuple, np.ndarray] = {}
    pw_tasks: list[tuple[int, np.ndarray]] = []
    for definition in definitions.sort_values(["strategy", "variant"]).itertuples(index=False):
        key = (definition.strategy, definition.variant)
        for boundary in BOUNDARIES:
            ledgers = {}
            for group, trades, market, funding in (
                    ("HISTORY", history[key], hist_market, hist_funding),
                    ("HOLD_A", force_window(full[key], all_market, *SEGMENTS["HOLD_A"]),
                     all_market, all_funding)):
                ledgers[group] = fast_ledger(trades, market, funding, boundary)
            for segment, (start, end) in SEGMENTS.items():
                group = "HOLD_A" if segment == "HOLD_A" else "HISTORY"
                trades = (force_window(full[key], all_market, start, end)
                          if segment == "HOLD_A" else history[key])
                market = all_market if segment == "HOLD_A" else hist_market
                pnl0, units = ledgers[group]
                selected = trades.loc[(trades.entry_time < end) & (trades.exit_time >= start)]
                benchmark = r235.b0_daily(boundary, segment).to_numpy(float)
                for cost in COSTS:
                    daily, minute = segment_daily(pnl0, units, market, start, end, cost)
                    if len(benchmark) != len(daily):
                        raise AssertionError("benchmark length mismatch")
                    standard = daily.std(ddof=1)
                    regression = r233.ols_hac(daily, benchmark)
                    row_number = len(metric_rows)
                    metric_rows.append({
                        "strategy": definition.strategy, "variant": definition.variant,
                        "f_leg": definition.f_leg, "e_leg": definition.e_leg,
                        "segment": segment, "boundary": boundary, "cost_bps": cost,
                        "trade_n": len(selected), "total_net_bps": float(daily.sum()),
                        "daily_sharpe": float(daily.mean() / standard * math.sqrt(365))
                        if standard > 0 else math.nan,
                        "mtm_max_drawdown_bps": r223._drawdown(minute),
                        "net_per_trade_bps": float(daily.sum() / len(selected))
                        if len(selected) else math.nan,
                        "alpha_daily_bps": regression["alpha_daily_bps"],
                        "beta": regression["beta"], "pw_status": "PENDING",
                        "pw_ci95_lower_daily_bps": math.nan, "dsr_trials": DSR_TRIALS,
                        "dsr": math.nan})
                    daily_cache[(definition.strategy, definition.variant, segment,
                                 boundary, cost)] = daily
                    pw_tasks.append((row_number, daily))
                    for date, value in zip(pd.date_range(start, end - pd.Timedelta(days=1),
                                                         freq="D", tz="UTC"), daily):
                        daily_rows.append({"strategy": definition.strategy,
                                           "variant": definition.variant,
                                           "segment": segment, "boundary": boundary,
                                           "cost_bps": cost, "date": date,
                                           "net_bps": float(value)})
        log(f"metrics ledger {definition.strategy}/{definition.variant}")

    metrics = pd.DataFrame(metric_rows)
    log(f"PW start tasks={len(pw_tasks)} workers={WORKERS}")
    with ProcessPoolExecutor(max_workers=WORKERS) as executor:
        for number, pw in executor.map(_pw_worker, pw_tasks, chunksize=2):
            metrics.loc[number, "pw_status"] = pw["status"]
            metrics.loc[number, "pw_ci95_lower_daily_bps"] = pw["ci95_lower"]

    for (segment, boundary, cost), part in metrics.groupby(
            ["segment", "boundary", "cost_bps"], sort=False):
        unannualized = part.daily_sharpe.to_numpy(float) / math.sqrt(365)
        variance = float(np.nanvar(unannualized, ddof=1))
        for index, row in part.iterrows():
            daily = daily_cache[(row.strategy, row.variant, segment, boundary, cost)]
            metrics.loc[index, "dsr"] = ledger.deflated_sharpe(
                daily, DSR_TRIALS, variance)["dsr"]

    baseline_variant = {"F3": "V0", "F3-w30": "V0", "E1": "V0",
                        "C1": "F_V0+E_V0", "C4": "F_V0+E_V0"}
    baseline = metrics.copy()
    baseline["wanted"] = baseline.strategy.map(baseline_variant)
    baseline = baseline.loc[baseline.variant.eq(baseline.wanted),
                            ["strategy", "segment", "boundary", "cost_bps",
                             "trade_n", "total_net_bps", "daily_sharpe"]].rename(columns={
                                 "trade_n": "baseline_trade_n",
                                 "total_net_bps": "baseline_total_net_bps",
                                 "daily_sharpe": "baseline_daily_sharpe"})
    metrics = metrics.merge(baseline, on=["strategy", "segment", "boundary", "cost_bps"],
                            validate="many_to_one")
    metrics["delta_trade_n"] = metrics.trade_n - metrics.baseline_trade_n
    metrics["delta_total_net_bps"] = metrics.total_net_bps - metrics.baseline_total_net_bps
    metrics["delta_sharpe"] = metrics.daily_sharpe - metrics.baseline_daily_sharpe
    metrics["paired_delta_sharpe"] = np.nan
    metrics["delta_pw_status"] = "BASELINE"
    metrics["delta_pw_ci95_lower_daily_bps"] = 0.0
    metrics["delta_dsr_trials"] = DELTA_DSR_TRIALS
    metrics["delta_dsr"] = np.nan
    delta_tasks: list[tuple[int, np.ndarray]] = []
    delta_cache: dict[int, np.ndarray] = {}
    for index, row in metrics.iterrows():
        if row.variant == baseline_variant[row.strategy]:
            continue
        daily = daily_cache[(row.strategy, row.variant, row.segment,
                             row.boundary, row.cost_bps)]
        base_daily = daily_cache[(row.strategy, baseline_variant[row.strategy], row.segment,
                                  row.boundary, row.cost_bps)]
        delta = daily - base_daily
        standard = delta.std(ddof=1)
        metrics.loc[index, "paired_delta_sharpe"] = (
            delta.mean() / standard * math.sqrt(365) if standard > 0 else math.nan)
        metrics.loc[index, "delta_pw_status"] = "PENDING"
        delta_tasks.append((index, delta))
        delta_cache[index] = delta
    log(f"paired-delta PW start tasks={len(delta_tasks)} workers={WORKERS}")
    with ProcessPoolExecutor(max_workers=WORKERS) as executor:
        for number, pw in executor.map(_pw_worker, delta_tasks, chunksize=2):
            metrics.loc[number, "delta_pw_status"] = pw["status"]
            metrics.loc[number, "delta_pw_ci95_lower_daily_bps"] = pw["ci95_lower"]
    for _, part in metrics.loc[metrics.delta_pw_status.ne("BASELINE")].groupby(
            ["segment", "boundary", "cost_bps"], sort=False):
        unannualized = part.paired_delta_sharpe.to_numpy(float) / math.sqrt(365)
        variance = float(np.nanvar(unannualized, ddof=1))
        for index in part.index:
            metrics.loc[index, "delta_dsr"] = ledger.deflated_sharpe(
                delta_cache[index], DELTA_DSR_TRIALS, variance)["dsr"]
    return metrics, pd.DataFrame(daily_rows), daily_cache


def trade_net(trades: pd.DataFrame, funding: pd.DataFrame,
              boundary: str, cost: float) -> np.ndarray:
    if trades.empty:
        return np.array([], float)
    internal, edge, _ = k45_funding.trade_funding_frame(
        trades.side, trades.entry_time, trades.exit_time, funding, boundary)
    gross = trades.side.to_numpy(float) * np.log(
        trades.exit_price.to_numpy(float) / trades.entry_price.to_numpy(float)) * 1e4
    return gross + internal + edge - cost


def missed_trade_metrics(history: dict[tuple[str, str], pd.DataFrame],
                         full: dict[tuple[str, str], pd.DataFrame],
                         definitions: pd.DataFrame, hist_funding: pd.DataFrame,
                         all_funding: pd.DataFrame,
                         full_signals: dict[tuple[str, str], tuple[pd.DatetimeIndex, np.ndarray]]
                         ) -> tuple[pd.DataFrame, pd.DataFrame]:
    baseline_variant = {"F3": "V0", "F3-w30": "V0", "E1": "V0",
                        "C1": "F_V0+E_V0", "C4": "F_V0+E_V0"}
    rows, trade_rows = [], []
    for definition in definitions.itertuples(index=False):
        baseline_name = baseline_variant[definition.strategy]
        if definition.variant == baseline_name:
            continue
        for segment, (start, end) in SEGMENTS.items():
            source = full if segment == "HOLD_A" else history
            funding = all_funding if segment == "HOLD_A" else hist_funding
            variant = source[(definition.strategy, definition.variant)].copy()
            if segment == "HOLD_A":
                variant = variant.loc[(variant.exit_time > start) & (variant.entry_time < end)].copy()
            in_segment = variant.entry_time.between(start, end, inclusive="left")
            caught = np.zeros(len(variant), bool)
            for position, trade in enumerate(variant.itertuples(index=False)):
                component, component_variant = str(trade.candidate).split("/", 1)
                time = pd.Timestamp(trade.entry_time)
                if component_variant == "V0" or time.minute == 0:
                    continue
                hourly_times, hourly_side = full_signals[(component, "V0")]
                hour_position = int(np.searchsorted(hourly_times.as_unit("ns").asi8,
                                                     time.ceil("h").value, side="left"))
                caught[position] = (hour_position < len(hourly_times) and
                                    hourly_times[hour_position] == time.ceil("h") and
                                    hourly_side[hour_position] == 0)
            missed = variant.loc[in_segment & caught].copy()
            if segment == "HOLD_A":
                # Distribution uses the same observable end as the HOLD_A ledger.
                force = missed.exit_time > end
                if force.any():
                    missed.loc[force, "exit_time"] = end
                    all_times = full[(definition.strategy, definition.variant)]
                    # Market end price is already stored on data-end trades.
                    end_price = float(all_times.exit_price.iloc[-1]) if len(all_times) else math.nan
                    missed.loc[force, "exit_price"] = end_price
            for boundary in BOUNDARIES:
                for cost in COSTS:
                    values = trade_net(missed, funding, boundary, cost)
                    quantile = lambda q: float(np.quantile(values, q)) if len(values) else math.nan
                    rows.append({"strategy": definition.strategy,
                                 "variant": definition.variant, "segment": segment,
                                 "boundary": boundary, "cost_bps": cost,
                                 "missed_trade_n": len(values),
                                 "total_net_bps": float(values.sum()),
                                 "mean_net_bps": float(values.mean()) if len(values) else math.nan,
                                 "p10_net_bps": quantile(.10), "p25_net_bps": quantile(.25),
                                 "median_net_bps": quantile(.50), "p75_net_bps": quantile(.75),
                                 "p90_net_bps": quantile(.90),
                                 "positive_ratio": float((values > 0).mean()) if len(values) else math.nan})
                    trade_rows.extend({"strategy": definition.strategy,
                                       "variant": definition.variant, "segment": segment,
                                       "boundary": boundary, "cost_bps": cost,
                                       "entry_time": trade.entry_time,
                                       "exit_time": trade.exit_time, "side": trade.side,
                                       "net_bps": float(value)}
                                      for trade, value in zip(missed.itertuples(index=False), values))
    return pd.DataFrame(rows), pd.DataFrame(trade_rows)


def parity_checks(metrics: pd.DataFrame) -> pd.DataFrame:
    reference = pd.read_parquet(r235.ROOT / "performance.parquet")
    rows = []
    mappings = {"F3": F3, "F3-w30": F3_W30, "C1": "C1", "C4": "C4"}
    for strategy, candidate in mappings.items():
        variant = "F_V0+E_V0" if strategy.startswith("C") else "V0"
        actual = metrics.loc[metrics.strategy.eq(strategy) & metrics.variant.eq(variant)]
        wanted = reference.loc[reference.candidate.eq(candidate) & reference.delay_min.eq(5)]
        for row in actual.itertuples(index=False):
            match = wanted.loc[wanted.segment.eq(row.segment) &
                               wanted.boundary.eq(row.boundary) &
                               wanted.cost_bps.eq(row.cost_bps)].iloc[0]
            rows.append({"strategy": strategy, "segment": row.segment,
                         "boundary": row.boundary, "cost_bps": row.cost_bps,
                         "trade_n_match": int(row.trade_n) == int(match.trade_n),
                         "net_abs_diff_bps": abs(row.total_net_bps - match.total_net_bps),
                         "sharpe_abs_diff": abs(row.daily_sharpe - match.daily_sharpe),
                         "mdd_abs_diff_bps": abs(row.mtm_max_drawdown_bps -
                                                  match.mtm_max_drawdown_bps)})
    result = pd.DataFrame(rows)
    if not (result.trade_n_match.all() and result.net_abs_diff_bps.max() < 1e-6 and
            result.sharpe_abs_diff.max() < 1e-9 and result.mdd_abs_diff_bps.max() < 1e-6):
        raise AssertionError("V0 does not reproduce adopted +5m baseline")
    return result


def report(missed_signals: pd.DataFrame, metrics: pd.DataFrame,
           missed_metrics: pd.DataFrame, parity: pd.DataFrame) -> tuple[str, list[str]]:
    metric_columns = ["strategy", "variant", "f_leg", "e_leg", "segment", "boundary",
                      "cost_bps", "trade_n", "total_net_bps", "daily_sharpe",
                      "mtm_max_drawdown_bps", "pw_ci95_lower_daily_bps",
                      "alpha_daily_bps", "beta", "net_per_trade_bps", "dsr",
                      "delta_trade_n", "delta_total_net_bps", "delta_sharpe",
                      "paired_delta_sharpe", "delta_pw_ci95_lower_daily_bps", "delta_dsr"]
    missed_columns = ["strategy", "variant", "segment", "boundary", "cost_bps",
                      "missed_trade_n", "total_net_bps", "mean_net_bps", "p10_net_bps",
                      "p25_net_bps", "median_net_bps", "p75_net_bps", "p90_net_bps",
                      "positive_ratio"]

    primary = metrics.loc[metrics.segment.eq("DEV_COMMON") & metrics.boundary.eq("PESS") &
                          metrics.cost_bps.eq(4)].copy()
    primary_missed = missed_metrics.loc[missed_metrics.segment.eq("DEV_COMMON") &
                                        missed_metrics.boundary.eq("PESS") &
                                        missed_metrics.cost_bps.eq(4)]
    joined = primary.merge(primary_missed[["strategy", "variant", "mean_net_bps"]],
                           on=["strategy", "variant"], how="left")
    supported = joined.loc[joined.delta_total_net_bps.gt(0) & joined.mean_net_bps.gt(0) &
                           joined.delta_dsr.ge(.95) &
                           joined.delta_pw_ci95_lower_daily_bps.gt(0),
                           ["strategy", "variant"]]
    candidates = [f"{row.strategy}/{row.variant}" for row in supported.itertuples(index=False)]
    hold = metrics.loc[metrics.segment.eq("HOLD_B") & metrics.boundary.eq("PESS") &
                       metrics.cost_bps.eq(4)].copy()
    if candidates:
        wanted = set(tuple(value.split("/", 1)) for value in candidates)
        hold_supported = hold.loc[[tuple(row) in wanted for row in
                                   hold[["strategy", "variant"]].itertuples(index=False, name=None)]]
        hold_positive = int(hold_supported.delta_total_net_bps.gt(0).sum())
        opinion = (f"DEV 표시 규칙(증분 net>0, 놓친 거래 평균>0, paired-delta DSR>=0.95, paired PW 하한>0)을 "
                   f"{len(candidates)}개가 통과했다: {', '.join(candidates)}. 이 후보만 별도 모의 장부·새 T0로 "
                   f"추적할 근거는 있다. HOLD_B에서 증분 net 양수는 {hold_positive}/{len(candidates)}개다. "
                   "기존 장부 교체 근거는 아니다. HOLD_A는 사후 참고다.")
    else:
        positive = joined.loc[joined.delta_total_net_bps.gt(0) & joined.mean_net_bps.gt(0)]
        best_lower = float(positive.delta_pw_ci95_lower_daily_bps.max()) if len(positive) else math.nan
        best_dsr = float(positive.delta_dsr.max()) if len(positive) else math.nan
        opinion = ("DEV 표시 규칙(증분 net>0, 놓친 거래 평균>0, paired-delta DSR>=0.95, paired PW 하한>0)을 "
                   f"통과한 변형이 없다. 방향상 둘 다 양수인 변형은 {len(positive)}개지만, 그중 가장 좋은 "
                   f"paired PW 하한도 {best_lower:.4f} bp/일, delta DSR도 최대 {best_dsr:.4f}다. "
                   "별도 모의 장부를 추가할 근거가 부족하다. HOLD_B/HOLD_A로 후보를 되살리면 선택 편향이다.")

    lines = [
        "# R2-37 판단 주기 검증", "",
        "## 1번 표 — DEV 놓친 신호", "", markdown(missed_signals, 3), "",
        "## 2번 표 — 전체 변형 백테스트", "", markdown(metrics[metric_columns], 4), "",
        "## 3번 표 — V0가 놓치고 변형이 잡은 거래", "",
        markdown(missed_metrics[missed_columns], 4), "",
        "## 정의·검증", "",
        "- V0: 채택된 `create_time+5m < 정시`와 완전한 1시간 봉. 판단시각 `t` 직전 닫힌 분까지 보고 `t` 1분봉 시가에 진입한다.",
        "- V5: `create_time+5m`에 새 LS 값을 평가한다. 기준선은 그 시각의 직전 정시판으로 한 시간 고정한다. V5r은 90일/30일을 각각 25,920/8,640개 5분 관측으로 재계산한다.",
        "- V1a: 직전 닫힌 분까지의 진행 중 정시 1시간 봉 누적 거래량·현재 종가를 이전 19개 완성봉과 비교한다. 돌파선은 이전 완성 20봉 고가다.",
        "- V1b: 매분 끝나는 60분 창과 같은 분 위상의 이전 비중첩 60분 창 19개로 z를 계산한다. 돌파선은 이전 비중첩 20창 고가다. 정시에는 V0와 exact 일치한다.",
        "- 놓친 신호: 정시가 아닌 조건 충족 구간 중 다음 정시 V0 신호가 0인 연속 episode. 지속시간은 관측점 수×판단 간격이다.",
