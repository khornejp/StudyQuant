    return "\n".join(lines), candidates


def main() -> None:
    started = utc_now()
    OUT.mkdir(parents=True, exist_ok=True)
    write_text(OUT / "run.log", "")
    log("load inputs")
    hist_market, hist_features, hist_funding, all_market, all_features, all_funding = r235.load_inputs()
    for frame in (hist_market, hist_features, all_market, all_features):
        frame["open_time"] = pd.to_datetime(frame.open_time, utc=True).astype("datetime64[ns, UTC]")
    if (all_market.open_time.diff().dropna() != pd.Timedelta(minutes=1)).any():
        raise AssertionError("market is not contiguous")
    bars = hourly_bars(all_market)
    log("build signals")
    f3_frames, f3_full = build_f3_signals(all_market, all_features, bars)
    e1_frames, e1_full = build_e1_signals(all_market, bars)
    signals, full_signals = {**f3_frames, **e1_frames}, {**f3_full, **e1_full}
    missed_signals = missed_signal_table(full_signals)
    log("simulate variants")
    history, full, definitions = build_trade_sets(signals, hist_market, all_market)
    log("evaluate")
    metrics, daily, _ = evaluate(history, full, definitions, hist_market, all_market,
                                 hist_funding, all_funding)
    missed_metrics, missed_trades = missed_trade_metrics(
        history, full, definitions, hist_funding, all_funding, full_signals)
    parity = parity_checks(metrics)

    strategy_rank = metrics.strategy.map(STRATEGY_ORDER)
    metrics = metrics.assign(_strategy=strategy_rank).sort_values(
        ["_strategy", "variant", "segment", "boundary", "cost_bps"]).drop(columns="_strategy").reset_index(drop=True)
    missed_metrics = missed_metrics.assign(_strategy=missed_metrics.strategy.map(STRATEGY_ORDER)).sort_values(
        ["_strategy", "variant", "segment", "boundary", "cost_bps"]).drop(columns="_strategy").reset_index(drop=True)
    report_text, candidates = report(missed_signals, metrics, missed_metrics, parity)

    trades = []
    for definition in definitions.itertuples(index=False):
        for group, source in (("HISTORY", history), ("THROUGH_HOLD_A", full)):
            trades.append(source[(definition.strategy, definition.variant)].assign(
                strategy=definition.strategy, variant=definition.variant, data_group=group))
    outputs = {
        "missed_signals.parquet": missed_signals,
        "backtest_metrics.parquet": metrics,
        "daily_pnl.parquet": daily,
        "missed_trade_metrics.parquet": missed_metrics,
        "missed_trades.parquet": missed_trades,
        "trades.parquet": pd.concat(trades, ignore_index=True, sort=False),
        "parity_checks.parquet": parity,
        "variant_definitions.parquet": definitions,
    }
    for name, frame in outputs.items():
        write_parquet(OUT / name, frame)
    write_text(OUT / "REPORT.md", report_text)

    hold_oos = metrics.loc[metrics.segment.eq("HOLD_B") & metrics.boundary.eq("PESS") &
                           metrics.cost_bps.eq(4) & metrics.delta_total_net_bps.ne(0),
                           ["strategy", "variant", "trade_n", "total_net_bps",
                            "delta_total_net_bps", "daily_sharpe", "dsr"]]
    source_paths = [r235.r214.MARKET, r235.HIST_FEATURES, r235.Q3_MARKET,
                    r235.Q3_FEATURES, r227.Q3_FUNDING, Path(r235.__file__),
                    Path(r224.__file__), Path(ledger.__file__), SCRIPT]
    manifest = {
        "experiment": "R2-37", "status": "COMPLETE", "started_utc": started,
        "finished_utc": utc_now(),
        "source": [file_record(path) for path in source_paths],
        "timestamp": utc_now(),
        "data_cutoff": {"DEV_COMMON": "2025-12-31T23:59:59Z",
                        "HOLD_B": "2026-06-30T23:59:59Z",
                        "HOLD_A_posthoc": "2026-09-30T23:59:59Z"},
        "frozen_hypothesis": FROZEN_HYPOTHESIS,
        "out_of_sample_result": {"segment": "HOLD_B", "role": "OOS",
