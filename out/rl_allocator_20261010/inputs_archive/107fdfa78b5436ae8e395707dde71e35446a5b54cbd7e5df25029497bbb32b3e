def markdown(frame: pd.DataFrame, decimals: int = 4) -> str:
    if frame.empty:
        return "| n |\n|---:|\n| 0 |"

    def cell(value: object) -> str:
        if pd.isna(value):
            return "NA"
        if isinstance(value, (bool, np.bool_)):
            return str(int(value))
        if isinstance(value, (float, np.floating)):
            return f"{value:.{decimals}f}"
        return str(value).replace("|", "\\|").replace("\n", " ")

    lines = ["| " + " | ".join(map(str, frame.columns)) + " |",
             "| " + " | ".join("---" for _ in frame.columns) + " |"]
    lines.extend("| " + " | ".join(cell(value) for value in row) + " |"
                 for row in frame.itertuples(index=False, name=None))
    return "\n".join(lines)


def hourly_bars(minutes: pd.DataFrame) -> pd.DataFrame:
    frame = minutes.set_index("open_time")
    grouped = frame.resample("60min", origin="epoch", label="left", closed="left")
    bars = grouped.agg(open=("open", "first"), high=("high", "max"),
                       low=("low", "min"), close=("close", "last"),
                       volume=("volume", "sum"))
    count = grouped.close.count()
    bars = bars.loc[count.eq(60)].reset_index().rename(columns={"open_time": "bar_start"})
    bars["decision_time"] = bars.bar_start + pd.Timedelta(hours=1)
    cutoff = minutes.open_time.iloc[-1] + pd.Timedelta(minutes=1)
    return bars.loc[bars.decision_time.le(cutoff)].reset_index(drop=True)


def sides(values: pd.Series, lower: pd.Series, upper: pd.Series) -> np.ndarray:
    result = np.zeros(len(values), np.int8)
    result[values.ge(upper).fillna(False).to_numpy()] = -1
    result[values.le(lower).fillna(False).to_numpy()] = 1
    return result


def signal_frame(times: pd.Series | pd.DatetimeIndex, side: np.ndarray) -> pd.DataFrame:
    times = pd.DatetimeIndex(pd.to_datetime(times, utc=True))
    mask = side != 0
    return pd.DataFrame({"decision_time": times[mask], "side": side[mask].astype(np.int8)})


def build_f3_signals(market: pd.DataFrame, features: pd.DataFrame,
                     bars: pd.DataFrame) -> tuple[dict[tuple[str, str], pd.DataFrame],
                                                  dict[tuple[str, str], tuple[pd.DatetimeIndex, np.ndarray]]]:
    feature_times = pd.DatetimeIndex(features.open_time).as_unit("ns").asi8
    decisions = pd.DatetimeIndex(bars.decision_time)
    # Frozen V0: archive create_time+5m must be strictly before T.  Minute cache
    # is forward-filled, so this is exactly the last row at T-6m.
    positions = np.searchsorted(feature_times + pd.Timedelta(minutes=5).value,
                                decisions.as_unit("ns").asi8, side="left") - 1
    hourly_ls = pd.Series(features.global_ls_account.to_numpy(float)[positions])

    create_mask = features.open_time.dt.minute.mod(5).eq(0)
    events = features.loc[create_mask, ["open_time", "global_ls_account"]].copy()
    events["available_time"] = events.open_time + pd.Timedelta(minutes=5)
    event_values = events.global_ls_account.reset_index(drop=True)
    event_times = pd.DatetimeIndex(events.available_time)

    frames: dict[tuple[str, str], pd.DataFrame] = {}
    full: dict[tuple[str, str], tuple[pd.DatetimeIndex, np.ndarray]] = {}
    specs = {"F3": (2_160, 720, .10, .90),
             "F3-w30": (720, 720, .20, .80)}
    for strategy, (window, minimum, qlow, qhigh) in specs.items():
        rolling = hourly_ls.rolling(window, min_periods=minimum)
        hourly_lower, hourly_upper = rolling.quantile(qlow), rolling.quantile(qhigh)
        v0_side = sides(hourly_ls, hourly_lower, hourly_upper)
        frames[(strategy, "V0")] = signal_frame(decisions, v0_side)
        full[(strategy, "V0")] = (decisions, v0_side)

        levels = pd.DataFrame({"decision_time": decisions,
                               "lower": hourly_lower.to_numpy(float),
                               "upper": hourly_upper.to_numpy(float)})
        fixed = pd.merge_asof(events[["available_time"]].sort_values("available_time"),
                              levels.sort_values("decision_time"),
                              left_on="available_time", right_on="decision_time",
                              direction="backward")
        v5_side = sides(event_values, fixed.lower, fixed.upper)
        frames[(strategy, "V5")] = signal_frame(event_times, v5_side)
        full[(strategy, "V5")] = (event_times, v5_side)

        factor = 12
        event_rolling = event_values.rolling(window * factor, min_periods=minimum * factor)
        v5r_side = sides(event_values, event_rolling.quantile(qlow),
                         event_rolling.quantile(qhigh))
        frames[(strategy, "V5r")] = signal_frame(event_times, v5r_side)
        full[(strategy, "V5r")] = (event_times, v5r_side)
    return frames, full


def build_e1_signals(market: pd.DataFrame, bars: pd.DataFrame
                     ) -> tuple[dict[tuple[str, str], pd.DataFrame],
                                dict[tuple[str, str], tuple[pd.DatetimeIndex, np.ndarray]]]:
    volume_mean = bars.volume.rolling(20).mean()
    volume_std = bars.volume.rolling(20).std(ddof=0)
    prior_high = bars.high.rolling(20).max().shift()
    v0_side = ((bars.volume - volume_mean).div(volume_std).gt(3) &
               bars.close.gt(prior_high)).to_numpy(np.int8)
    decisions = pd.DatetimeIndex(bars.decision_time)

    minute_times = pd.DatetimeIndex(market.open_time)
    minute_decisions = minute_times + pd.Timedelta(minutes=1)
    hour_key = market.open_time.dt.floor("h")
    partial_volume = market.volume.groupby(hour_key, sort=False).cumsum().to_numpy(float)
    bar_index = bars.set_index("bar_start")
    prior19_sum = bars.volume.shift().rolling(19).sum()
    prior19_sq = bars.volume.pow(2).shift().rolling(19).sum()
    mapped_sum = hour_key.map(pd.Series(prior19_sum.to_numpy(), index=bar_index.index)).to_numpy(float)
    mapped_sq = hour_key.map(pd.Series(prior19_sq.to_numpy(), index=bar_index.index)).to_numpy(float)
    mapped_high = hour_key.map(pd.Series(prior_high.to_numpy(), index=bar_index.index)).to_numpy(float)
    mean_a = (mapped_sum + partial_volume) / 20
    variance_a = (mapped_sq + partial_volume ** 2) / 20 - mean_a ** 2
    z_a = (partial_volume - mean_a) / np.sqrt(np.maximum(variance_a, 0))
    v1a_side = ((z_a > 3) & (market.close.to_numpy(float) > mapped_high)).astype(np.int8)

    vol60 = market.volume.rolling(60, min_periods=60).sum().to_numpy(float)
    high60 = market.high.rolling(60, min_periods=60).max().to_numpy(float)
    phase = minute_decisions.minute.to_numpy()
    z_b = np.full(len(market), np.nan)
    high_b = np.full(len(market), np.nan)
    for minute in range(60):
        index = np.flatnonzero(phase == minute)
        volume = pd.Series(vol60[index])
        z_b[index] = ((volume - volume.rolling(20).mean()) /
                      volume.rolling(20).std(ddof=0)).to_numpy(float)
        high_b[index] = pd.Series(high60[index]).rolling(20).max().shift().to_numpy(float)
    v1b_side = ((z_b > 3) & (market.close.to_numpy(float) > high_b)).astype(np.int8)

    on_hour = minute_decisions.minute == 0
    if not (np.array_equal(v1a_side[on_hour], v0_side) and
            np.array_equal(v1b_side[on_hour], v0_side)):
        raise AssertionError("E1 minute alternatives do not reproduce V0 on the hour")

    frames = {("E1", "V0"): signal_frame(decisions, v0_side),
              ("E1", "V1a"): signal_frame(minute_decisions, v1a_side),
              ("E1", "V1b"): signal_frame(minute_decisions, v1b_side)}
    full = {("E1", "V0"): (decisions, v0_side),
            ("E1", "V1a"): (minute_decisions, v1a_side),
            ("E1", "V1b"): (minute_decisions, v1b_side)}
    return frames, full


def price_at(market: pd.DataFrame, time: pd.Timestamp) -> float | None:
    position = int(np.searchsorted(market.open_time.array.asi8, time.value, side="left"))
    if position >= len(market) or market.open_time.iloc[position] != time:
        return None
    return float(market.open.iloc[position])


def simulate(signals: pd.DataFrame, market: pd.DataFrame, hold_hours: int,
             label: str) -> pd.DataFrame:
    end_time = market.open_time.iloc[-1] + pd.Timedelta(minutes=1)
    rows: list[dict[str, object]] = []
    position = 0
    entry_time: pd.Timestamp | None = None
    entry_price = math.nan
    expiry: pd.Timestamp | None = None

    def close(time: pd.Timestamp, price: float, reason: str) -> None:
        nonlocal position, entry_time, entry_price, expiry
        rows.append({"candidate": label, "entry_time": entry_time, "exit_time": time,
                     "side": position, "entry_price": entry_price, "exit_price": price,
                     "exit_reason": reason})
        position, entry_time, entry_price, expiry = 0, None, math.nan, None

    for row in signals.itertuples(index=False):
        time, desired = pd.Timestamp(row.decision_time), int(row.side)
        if time >= end_time:
            break
        while position and expiry is not None and expiry <= time:
            expiry_price = price_at(market, expiry)
            if expiry_price is None:
                break
            close(expiry, expiry_price, "max_hold")
        execution_price = price_at(market, time)
        if execution_price is None:
            continue
        if position and desired == -position:
            close(time, execution_price, "reverse")
        if not position:
            position, entry_time, entry_price = desired, time, execution_price
            expiry = time + pd.Timedelta(hours=hold_hours)
    if position:
        if expiry is not None and expiry < end_time:
            expiry_price = price_at(market, expiry)
            if expiry_price is not None:
                close(expiry, expiry_price, "max_hold")
        if position:
            close(end_time, float(market.close.iloc[-1]), "data_end")
    return pd.DataFrame(rows)


def force_window(trades: pd.DataFrame, market: pd.DataFrame,
                 start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:
    result = trades.loc[(trades.exit_time > start) & (trades.entry_time < end)].copy()
    force = result.exit_time > end
    if force.any():
        position = int(np.searchsorted(market.open_time.array.asi8, end.value, side="left")) - 1
        result.loc[force, "exit_time"] = end
        result.loc[force, "exit_price"] = float(market.close.iloc[position])
        result.loc[force, "exit_reason"] = "segment_end"
    return result.reset_index(drop=True)


