def missed_episodes(times: pd.DatetimeIndex, variant_side: np.ndarray,
                    hourly_times: pd.DatetimeIndex, hourly_side: np.ndarray,
                    cadence_minutes: int, strategy: str, variant: str) -> dict[str, object]:
    start, end = SEGMENTS["DEV_COMMON"]
    next_hour = times.ceil("h")
    hourly_lookup = pd.Series(hourly_side, index=hourly_times)
    next_side = hourly_lookup.reindex(next_hour).to_numpy(float)
    mask = ((times >= start) & (times < end) & (times.minute != 0) &
            (variant_side != 0) & (next_side == 0))
    positions = np.flatnonzero(mask)
    if not len(positions):
        durations = np.array([], float)
        episode_side = np.array([], np.int8)
        missed_hours = 0
    else:
        selected_time = times[positions]
        selected_side = variant_side[positions]
        selected_hour = next_hour[positions]
        new = np.r_[True, (np.diff(selected_time.asi8) != pd.Timedelta(
            minutes=cadence_minutes).value) | (selected_side[1:] != selected_side[:-1]) |
                    (selected_hour[1:].asi8 != selected_hour[:-1].asi8)]
        groups = np.cumsum(new) - 1
        counts = np.bincount(groups)
        durations = counts * cadence_minutes
        episode_side = selected_side[np.flatnonzero(new)]
        missed_hours = len(pd.unique(selected_hour))
    quantile = lambda q: float(np.quantile(durations, q)) if len(durations) else math.nan
    return {"strategy": strategy, "variant": variant,
            "cadence_min": cadence_minutes, "signal_points": int(mask.sum()),
            "missed_hours": int(missed_hours), "missed_episodes": int(len(durations)),
            "long_episodes": int((episode_side == 1).sum()),
            "short_episodes": int((episode_side == -1).sum()),
            "duration_mean_min": float(durations.mean()) if len(durations) else math.nan,
            "duration_p25_min": quantile(.25), "duration_p50_min": quantile(.50),
            "duration_p75_min": quantile(.75), "duration_p90_min": quantile(.90),
            "duration_max_min": float(durations.max()) if len(durations) else math.nan}


def missed_signal_table(full_signals: dict[tuple[str, str], tuple[pd.DatetimeIndex, np.ndarray]]) -> pd.DataFrame:
    rows = []
    for strategy, variants, cadence in (("F3", ("V5", "V5r"), 5),
                                         ("F3-w30", ("V5", "V5r"), 5),
                                         ("E1", ("V1a", "V1b"), 1)):
        hourly_times, hourly_side = full_signals[(strategy, "V0")]
        for variant in variants:
            times, side = full_signals[(strategy, variant)]
            rows.append(missed_episodes(times, side, hourly_times, hourly_side,
                                        cadence, strategy, variant))
    return pd.DataFrame(rows)


def fast_ledger(trades: pd.DataFrame, market: pd.DataFrame,
                funding: pd.DataFrame, boundary: str) -> tuple[np.ndarray, np.ndarray]:
    n = len(market)
    pnl = np.zeros(n, float)
    units = np.zeros(n, float)
    if trades.empty:
        return pnl, units
    times = market.open_time.array.asi8
    closes = market.close.to_numpy(float)
    log_close = np.log(closes)
    log_return = np.r_[0.0, np.diff(log_close)]
    exposure_delta = np.zeros(n + 1, float)
    entries = pd.DatetimeIndex(trades.entry_time).as_unit("ns").asi8
    exits = pd.DatetimeIndex(trades.exit_time).as_unit("ns").asi8
    left = np.searchsorted(times, entries, side="left")
    right = np.searchsorted(times, exits, side="right")
    sides_ = trades.side.to_numpy(float)
    entry_price = trades.entry_price.to_numpy(float)
    exit_price = trades.exit_price.to_numpy(float)
    for i, (a, b, side) in enumerate(zip(left, right, sides_)):
        if a >= n or b <= a:
            continue
        if b - a == 1:
            pnl[a] += side * math.log(exit_price[i] / entry_price[i]) * 1e4
        else:
            pnl[a] += side * (log_close[a] - math.log(entry_price[i])) * 1e4
            if b - a > 2:
                exposure_delta[a + 1] += side
                exposure_delta[b - 1] -= side
            pnl[b - 1] += side * (math.log(exit_price[i]) - log_close[b - 2]) * 1e4
        units[a] += .5
        units[b - 1] += .5
    pnl += np.cumsum(exposure_delta[:-1]) * log_return * 1e4

    funding_times = pd.DatetimeIndex(funding.time).as_unit("ns").asi8
    funding_rates = funding.rate.to_numpy(float)
    for entry, exit_, side in zip(entries, exits, sides_):
        lo = np.searchsorted(funding_times, entry, side="left")
        hi = np.searchsorted(funding_times, exit_, side="right")
        for event, rate in zip(funding_times[lo:hi], funding_rates[lo:hi]):
            cashflow = -side * rate * 1e4
            include = ((entry < event < exit_) or
                       (event == entry and k45_funding.include_boundary_cashflow(
                           "entry", cashflow, boundary)) or
                       (event == exit_ and k45_funding.include_boundary_cashflow(
                           "exit", cashflow, boundary)))
            if include:
                position = int(np.searchsorted(times, event, side="left"))
                if position >= n or times[position] != event:
                    raise ValueError("funding time outside minute index")
                pnl[position] += cashflow
    return pnl, units


def segment_daily(pnl0: np.ndarray, units: np.ndarray, market: pd.DataFrame,
                  start: pd.Timestamp, end: pd.Timestamp, cost: float
                  ) -> tuple[np.ndarray, np.ndarray]:
    times = market.open_time.array.asi8
    left = int(np.searchsorted(times, start.value, side="left"))
    right = int(np.searchsorted(times, end.value, side="left"))
    values = pnl0[left:right] - cost * units[left:right]
    expected = int((end - start) / pd.Timedelta(minutes=1))
    if len(values) != expected or len(values) % 1_440:
        raise AssertionError("segment minute coverage mismatch")
    return values.reshape(-1, 1_440).sum(axis=1), values


